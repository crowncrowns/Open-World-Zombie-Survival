.city-window { padding: 10px; }
.city-title { font-size: 18px; -unity-font-style: bold; margin-bottom: 8px; }
.city-row { flex-direction: row; flex-wrap: wrap; margin-top: 6px; margin-bottom: 6px; }
.city-row > Button { flex-grow: 1; min-width: 120px; min-height: 25px; }
.city-form { margin-top: 8px; margin-bottom: 8px; }
.city-report { white-space: normal; margin-top: 10px; padding: 8px; background-color: rgba(127,127,127,0.12); }
.city-status { min-height: 48px; max-height: 150px; flex-shrink: 0; }
.city-preview { height: 230px; margin-top: 8px; }
